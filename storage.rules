rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isVerifiedOwner(userId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedOwner(userId) && isValidImageUpload();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /project-images/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isVerifiedOwner(userId) && isValidImageUpload();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
